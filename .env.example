# DiamondScope environment variables
# Copy to .env and fill in.

# --- Postgres ---
POSTGRES_USER=diamondscope
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_DB=diamondscope
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://diamondscope:changeme_in_prod@db:5432/diamondscope

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed by CORS; include the deployed frontend URL in prod.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth (Phase 5) ---
JWT_SECRET=replace_with_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=bkasman95@gmail.com
ADMIN_PASSWORD=set_a_strong_password_here

# --- Data cache ---
# Path inside the container for the Parquet cache (mounted as persistent volume in prod).
CACHE_DIR=/app/cache
# Default analysis window in seasons.
DEFAULT_SEASON_WINDOW=6

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
